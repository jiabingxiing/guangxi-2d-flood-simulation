{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://floodviz.local/schemas/statistics.schema.json",
  "title": "floodviz statistics.json",
  "type": "object",
  "required": ["schema_version", "case_id", "run_id", "unit_area", "thresholds_m", "grid_cell_area_m2", "frames"],
  "additionalProperties": true,
  "properties": {
    "schema_version": {"const": "1.0"},
    "case_id": {"type": "string"},
    "run_id": {"type": "string"},
    "unit_area": {"const": "km2"},
    "thresholds_m": {"type": "array", "items": {"type": "number", "exclusiveMinimum": 0}, "minItems": 1},
    "grid_cell_area_m2": {"type": "number", "exclusiveMinimum": 0},
    "valid_cell_count": {"type": "integer", "minimum": 0},
    "sea_cell_count": {"type": "integer", "minimum": 0},
    "frames": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["frame_id", "sim_seconds", "timestamp", "areas_km2", "wetted_cells"],
        "properties": {
          "frame_id": {"type": "string", "pattern": "^f[0-9]{4,}$"},
          "sim_seconds": {"type": "number", "minimum": 0},
          "timestamp": {"type": ["string", "null"]},
          "areas_km2": {
            "type": "object",
            "additionalProperties": {"type": "number", "minimum": 0}
          },
          "wetted_cells": {
            "type": "object",
            "additionalProperties": {"type": "integer", "minimum": 0}
          }
        }
      }
    },
    "max_envelope": {
      "type": "object",
      "properties": {
        "areas_km2": {"type": "object", "additionalProperties": {"type": "number", "minimum": 0}},
        "wetted_cells": {"type": "object", "additionalProperties": {"type": "integer", "minimum": 0}},
        "peak_frame_id": {"type": "string"},
        "peak_time_s": {"type": "number"}
      }
    }
  }
}
