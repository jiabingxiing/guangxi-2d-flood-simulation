{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://floodviz.local/schemas/images.schema.json",
  "title": "floodviz frames/<case>/<run>/images.json（逐帧显示图索引，含子图 parts）",
  "type": "object",
  "required": ["schema_version", "case_id", "run_id", "kind", "grid", "color_scale", "split", "frames", "max"],
  "additionalProperties": true,
  "properties": {
    "schema_version": {"const": "1.0"},
    "case_id": {"type": "string"},
    "run_id": {"type": "string"},
    "kind": {"const": "depth_frames"},
    "grid": {
      "type": "object",
      "required": ["crs", "rows", "cols", "transform", "cell_size_m", "cell_area_m2"],
      "properties": {
        "crs": {"type": "string", "pattern": "^EPSG:[0-9]+$"},
        "rows": {"type": "integer", "minimum": 1},
        "cols": {"type": "integer", "minimum": 1},
        "transform": {"type": "array", "items": {"type": "number"}, "minItems": 6, "maxItems": 6},
        "cell_size_m": {"type": "number", "exclusiveMinimum": 0},
        "cell_area_m2": {"type": "number", "exclusiveMinimum": 0}
      }
    },
    "color_scale": {
      "type": "object",
      "required": ["transparent_below_m", "classes"],
      "properties": {
        "transparent_below_m": {"type": "number", "minimum": 0},
        "classes": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["min_m", "max_m", "color", "label"],
            "properties": {
              "min_m": {"type": "number"},
              "max_m": {"type": ["number", "null"]},
              "color": {"type": "string", "pattern": "^#[0-9a-fA-F]{6}$"},
              "label": {"type": "string"}
            }
          }
        }
      }
    },
    "split": {
      "type": "object",
      "required": ["rows", "cols"],
      "properties": {
        "rows": {"type": "integer", "minimum": 1},
        "cols": {"type": "integer", "minimum": 1}
      }
    },
    "frames": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["frame_id", "max_depth_m", "wet_pixels", "parts"],
        "properties": {
          "frame_id": {"type": "string", "pattern": "^f[0-9]{4,}$"},
          "max_depth_m": {"type": "number", "minimum": 0},
          "wet_pixels": {"type": "integer", "minimum": 0},
          "parts": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/part"}}
        }
      }
    },
    "max": {
      "type": "object",
      "required": ["max_depth_m", "wet_pixels", "parts"],
      "properties": {
        "max_depth_m": {"type": "number", "minimum": 0},
        "wet_pixels": {"type": "integer", "minimum": 0},
        "parts": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/part"}}
      }
    }
  },
  "$defs": {
    "part": {
      "type": "object",
      "required": ["id", "row", "col", "path", "width", "height", "coordinates"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "row": {"type": "integer", "minimum": 0},
        "col": {"type": "integer", "minimum": 0},
        "path": {"type": "string", "pattern": "^frames/.+_r[0-9]+c[0-9]+\\.png$"},
        "width": {"type": "integer", "minimum": 1, "maximum": 4096},
        "height": {"type": "integer", "minimum": 1, "maximum": 4096},
        "coordinates": {
          "type": "array",
          "minItems": 4,
          "maxItems": 4,
          "items": {"type": "array", "items": {"type": "number"}, "minItems": 2, "maxItems": 2}
        },
        "max_depth_m": {"type": "number", "minimum": 0},
        "wet_pixels": {"type": "integer", "minimum": 0}
      }
    }
  }
}
