{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://floodviz.local/schemas/numeric_manifest.schema.json",
  "title": "floodviz numeric/<case>/<run>/manifest.json",
  "type": "object",
  "required": ["schema_version", "case_id", "run_id", "grid", "block_size", "blocks", "dtype", "byte_order", "nodata", "layout", "mask_png", "mask_encoding", "frames"],
  "additionalProperties": true,
  "properties": {
    "schema_version": {"const": "1.0"},
    "case_id": {"type": "string"},
    "run_id": {"type": "string"},
    "grid": {
      "type": "object",
      "required": ["crs", "rows", "cols", "transform", "cell_size_m", "cell_area_m2"],
      "properties": {
        "crs": {"type": "string", "pattern": "^EPSG:[0-9]+$"},
        "rows": {"type": "integer", "minimum": 1},
        "cols": {"type": "integer", "minimum": 1},
        "transform": {"type": "array", "items": {"type": "number"}, "minItems": 6, "maxItems": 6},
        "cell_size_m": {"type": "number", "exclusiveMinimum": 0},
        "cell_area_m2": {"type": "number", "exclusiveMinimum": 0}
      }
    },
    "block_size": {"type": "integer", "minimum": 1},
    "blocks": {
      "type": "object",
      "required": ["rows", "cols"],
      "properties": {
        "rows": {"type": "integer", "minimum": 1},
        "cols": {"type": "integer", "minimum": 1}
      }
    },
    "dtype": {"const": "<f4"},
    "byte_order": {"const": "little"},
    "nodata": {"const": "nan"},
    "layout": {"type": "string", "minLength": 1},
    "mask_png": {"type": "string", "pattern": "^numeric/"},
    "mask_encoding": {"type": "string", "minLength": 1},
    "frames": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["frame_id", "path_template"],
        "properties": {
          "frame_id": {"type": "string", "pattern": "^f[0-9]{4,}$"},
          "path_template": {"type": "string", "pattern": "^numeric/.+\\{block_y\\}/\\{block_x\\}\\.bin$"}
        }
      }
    },
    "max": {
      "type": "object",
      "properties": {
        "path_template": {"type": "string", "pattern": "^numeric/.+\\{block_y\\}/\\{block_x\\}\\.bin$"}
      }
    }
  }
}
