# 数据与运行产物：不提交二进制/大文件，只保留说明与固定抽样索引
.venv/
__pycache__/
*.py[cod]
.pytest_cache/
.ruff_cache/
.coverage
htmlcov/

# 发布包与运行产物
outputs/web_bundle/
# 归档的历史发布包（200 m 旧代）：三个包约 1.97 GB / 8 793 文件，不入库
# 2026-10-30 补：原规则只覆盖 outputs/web_bundle/，导致归档目录 8 793 个文件待追踪
outputs/_archive_bundles/
outputs/build/
outputs/*.zip
# web/.dev 开发产物（2026-10-31 补）：mock 包由 web/.dev/make_mock_bundle.py 再生（e2e 用），
# 截图为开发期手工验证存档，均不入库；.dev 下探测/压测脚本保留入库
web/.dev/mock_bundle/
web/.dev/screenshots/
logs/
*.log

# standalone：发布内容不入库；只保留启动器真源 standalone/_launcher/
# 2026-10-30 实测：清理前的 standalone 目录有 3 590 文件 / 744 MB，
# 同步后的镜像目录有 718 文件 / 104 MB，都不应入库。
# _backup_* 是人工清理前的备份，同样不入库。
standalone/*
!standalone/_launcher/

# 大体积数据目录：只保留 README/.gitkeep 与 splits
data/raw/*
!data/raw/README.md
!data/raw/.gitkeep
data/interim/*
!data/interim/README.md
!data/interim/.gitkeep
data/processed/*
!data/processed/README.md
!data/processed/.gitkeep
data/external/*
!data/external/README.md
!data/external/.gitkeep
!data/external/licenses/

# 秘密与凭证
.env
*.token
secrets.
